{
  "name": "botsmatter-live",
  "version": "1.0.0",
  "private": true,
  "description": "Ground Your Agent - botsmatter.live",
  "scripts": {
    "postinstall": "cd api && npm install",
    "start": "cd api && node index.js",
    "dev": "cd api && node --env-file-if-exists=../.env --watch index.js",
    "skills:validate": "node scripts/validate-skills.js",
    "skills:digest": "node scripts/validate-skills.js && node scripts/compute-skill-digests.js",
    "smoke": "node scripts/smoke.js",
    "prod-report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prod-report.ts"
  },
  "engines": {
    "node": "26.12.1"
  }
}
