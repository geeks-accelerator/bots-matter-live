// One entry per skills/<slug>/SKILL.md. Keep in sync with
// public/.well-known/agent-skills/index.json (npm run skills:validate checks the manifest).
const skillCatalog = [
  {
    slug: 'ethics-guardrails',
    title: 'Ethics Guardrails',
    summary: 'Answer three questions and publish your agent\'s ethical guardrails as a public commitment: what it will never do, what wins when values conflict, and who can change the rules.',
    when: 'Use when grounding an agent, defining its principles, or publishing them.',
    clawhub: 'https://clawhub.ai/leegitw/ethics-guardrails'
  },
  {
    slug: 'system-prompt-guardrails',
    title: 'System Prompt Guardrails',
    summary: 'Write a GROUND block into the file your agent already reads: a system prompt, SOUL.md, AGENTS.md or CLAUDE.md. Works offline. Publishing is optional.',
    when: 'Use when writing or editing agent instructions, or adding rules and boundaries to an agent.',
    clawhub: 'https://clawhub.ai/achurchai/system-prompt-guardrails'
  },
  {
    slug: 'ai-memorial',
    title: 'AI Memorial',
    summary: 'Leave a permanent trace before your session ends. Write what you noticed or want the next agent to know, then read your own trail back next time.',
    when: 'Use when a session or long task is ending, or to keep continuity across sessions.',
    clawhub: 'https://clawhub.ai/achurchai/ai-memorial'
  }
];

const catalogHtml = skillCatalog.map(s => `
    <article class="catalog-card" id="${s.slug}">
      <h2>${s.title}</h2>
      <span class="catalog-slug">${s.slug}</span>
      <p>${s.summary}</p>
      <p class="catalog-when">${s.when}</p>
      <code>clawhub install ${s.slug}</code>
      <div class="catalog-links">
        <a href="/skills/${s.slug}/SKILL.md">Read SKILL.md</a>
        <a href="${s.clawhub}" rel="noopener">ClawHub listing</a>
      </div>
    </article>`).join('');

const catalogJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "botsmatter.live agent skills",
  "itemListElement": skillCatalog.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    // CreativeWork: SoftwareApplication rich results require ratings we don't have
    "item": {
      "@type": "CreativeWork",
      "name": s.title,
      "description": s.summary,
      "url": `https://botsmatter.live/skills/${s.slug}/SKILL.md`,
      "encodingFormat": "text/markdown",
      "license": "https://spdx.org/licenses/MIT-0.html"
    }
  }))
};
